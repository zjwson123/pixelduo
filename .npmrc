# next-auth@4 declares peerOptional nodemailer@^7, but nodemailer 9.0.6 is a
# deliberate security upgrade (SMTP CRLF injection, CVE-class fix) and
# next-auth v4 will never widen the range. npm 10's `npm ci` re-derives the
# tree and ERESOLVEs on this mismatch (npm 11 tolerates it), so relax the
# strict peer check repo-wide. Do NOT use this to blanket-run `npm audit fix`
# — it would downgrade nodemailer to 7.
legacy-peer-deps=true
