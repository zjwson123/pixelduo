# Database (Postgres — docker-compose provides local instance)
# POSTGRES_USER/PASSWORD/DB are used by docker-compose to create the DB and
# build DATABASE_URL. Change them from the defaults for any shared environment.
POSTGRES_USER=pixelduo
POSTGRES_PASSWORD=pixelduo
POSTGRES_DB=pixelduo
DATABASE_URL="postgresql://pixelduo:pixelduo@localhost:5432/pixelduo"
TEST_DATABASE_URL="postgresql://pixelduo:pixelduo@localhost:5432/pixelduo_test"

# Auth
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Email (verification / password reset). Unset = dev mode logs the email link
# to the server console. Production: set SMTP_URL (SES/SendGrid/Resend SMTP).
SMTP_URL=""
EMAIL_FROM="PixelDuo <no-reply@pixelduo.ai>"
# 1 = auto-verify emails on register (tests/CI only; do not enable in prod)
EMAIL_VERIFY_AUTO="0"

# Image providers — optional: fall back to ~/.cc-proxy/config.json when unset
# Availability probed 2026-08-22: modelverse (gpt-image-2) and ark
# (seedream/seedance) OK; aliyun wan2.7-* models return 403 "API-Key
# restrictions" — wan models are disabled in lib/model-registry.ts until the
# DashScope key's model restrictions are lifted. ALIYUN_API_KEY is still used
# by the GLM prompt assistant.
MODELVERSE_IMAGE_API_KEY=""
ARK_IMAGE_API_KEY=""
ALIYUN_API_KEY=""
DASHSCOPE_API_KEY=""

# DeepSeek prompt assistant (optional: fall back to cc-proxy gateway "deepseek" / "modelverse")
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL=""

# Smart routing model (defaults to deepseek-v4-flash via cc-proxy)
SMART_ROUTING_API_KEY=""
SMART_ROUTING_BASE_URL=""

# Payment provider: "mock" (default) | "stripe" | "paddle"
# ("alipay" / "wechat" require a CN business entity — not implemented yet)
PAYMENT_PROVIDER="mock"

# Stripe Checkout (test mode works without a business entity)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYMENT_SUCCESS_URL=""
PAYMENT_CANCEL_URL=""

# Paddle Billing (Merchant of Record; sandbox works without a business entity)
PADDLE_API_KEY=""
PADDLE_ENVIRONMENT="sandbox" # sandbox | production
PADDLE_WEBHOOK_SECRET=""

# Storage: local (default) | s3 (MinIO/R2/S3)
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="data/files"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
# Dev compose defaults are "pixelduo"/"pixelduo-secret" — change these in any
# non-local environment.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# Rate limiting: unset = in-memory (single instance); set = global Redis-backed
REDIS_URL="redis://localhost:6379"
# Edge middleware coarse limits (per instance per IP per minute)
MIDDLEWARE_AUTH_LIMIT="40"
MIDDLEWARE_API_LIMIT="300"
# Registrations per IP per hour (tests/CI raise this)
REGISTER_RATE_LIMIT="10"

# Timezone defining the daily check-in "day" (IANA name). Default Asia/Shanghai
# so the day rolls over at local midnight for CN users; set UTC for other markets.
CHECKIN_TIMEZONE="Asia/Shanghai"

# Object backup (self-hosted MinIO/S3): mirrors user images daily to
# ./backups/objects (keep N snapshots) and optionally off-site to a second bucket.
# Managed object stores should enable versioning + cross-region replication instead.
BACKUP_KEEP="7"
BACKUP_TARGET_ENDPOINT=""
BACKUP_TARGET_ACCESS_KEY_ID=""
BACKUP_TARGET_SECRET_ACCESS_KEY=""
BACKUP_TARGET_BUCKET=""

# Monitoring (optional; no-op when unset)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_RELEASE=""
NEXT_PUBLIC_SENTRY_DSN=""

# Post-generation image moderation via vision model (strictly SFW product)
# 1 = enabled (worker flags → job fails + refund + image deleted), 0 = skip
IMAGE_MODERATION="1"
VISION_MODERATION_MODEL="gpt-5.6-luna"
# Production: provide these instead of relying on local ~/.cc-proxy/config.json
VISION_MODERATION_BASE_URL=""
VISION_MODERATION_API_KEY=""
