# Database (Postgres — docker-compose provides local instance)
# POSTGRES_USER/PASSWORD/DB are used by docker-compose to create the DB and
# build DATABASE_URL. Change them from the defaults for any shared environment.
POSTGRES_USER=pixelduo
POSTGRES_PASSWORD=pixelduo
POSTGRES_DB=pixelduo
# Leave the URL alone and lib/prisma.ts appends `?options=-c timezone=UTC` —
# every deadline and schedule comparison in the money paths is done in SQL
# (`now()` vs a bare `timestamp` column, and every `@default(now())` column),
# and a session on the server's local time shifts all of them by the offset,
# silently, in both directions. If you supply your OWN `options=` (it wins), or
# connect through a pooler that strips the parameter, the production boot checks
# verify the session really is on UTC and refuse to start if it is not. Make
# sure the database behind a managed URL also defaults to UTC
# (`ALTER DATABASE <db> SET timezone TO 'UTC'`).
DATABASE_URL="postgresql://pixelduo:pixelduo@localhost:5432/pixelduo"
TEST_DATABASE_URL="postgresql://pixelduo:pixelduo@localhost:5432/pixelduo_test"

# Auth
# Must be >= 32 random characters: it signs every session JWT, so a guessable
# value is a full authentication bypass. Generate with `openssl rand -base64 32`.
# A production boot refuses placeholder/too-short values (instrumentation.ts).
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Per-IP rate limits read the LAST X-Forwarded-For entry (the one the edge
# proxy appends; Caddy's reverse_proxy always sets it). Only set this to 1 if
# your ingress sets X-Real-IP and does NOT set X-Forwarded-For — otherwise the
# client could choose its own bucket and defeat every per-IP limit.
TRUST_X_REAL_IP="0"

# Email (verification / password reset). Unset = dev mode logs the email link
# to the server console. Production: set SMTP_URL (SES/SendGrid/Resend SMTP) —
# production refuses to start without it, because the log-only mailer would
# write live password-reset links into the container log. MAIL_DEV_MODE=1 is
# the explicit opt-in for that behaviour.
SMTP_URL=""
EMAIL_FROM="PixelDuo <no-reply@pixelduo.ai>"
# Where user feedback (POST /api/feedback) is delivered. MUST be set in
# production: the fallback in lib/mail.ts is a personal mailbox, and a
# production runtime refuses to send feedback mail at all while FEEDBACK_TO is
# empty (the message is still stored and shown in the admin console). Reply-To
# is the reporter, so replying in your mail client answers them. Compose only
# forwards the variables its x-appenv anchor names, so this has to be listed
# there too — see docker-compose.yml.
FEEDBACK_TO=""
# 1 = auto-verify emails on register (tests/CI only; do not enable in prod)
EMAIL_VERIFY_AUTO="0"
# Opt in to the log-only mailer in production (see SMTP_URL above).
MAIL_DEV_MODE="0"

# Optional second notification channel, for hosts where SMTP is not an option
# (no provider account, no verified sending domain): a Feishu/WeCom/DingTalk
# group bot. The URL is a bearer secret — never commit it, and note the
# pre-flight scripts print it masked for that reason. Verify with
# `npx tsx scripts/verify-webhook.ts` (add --print to see the JSON only).
FEEDBACK_WEBHOOK_URL=""
FEEDBACK_WEBHOOK_KIND="feishu"   # feishu | wecom | dingtalk | raw
# Outbound feedback notifications (mail + webhook) allowed per hour, across all
# source addresses. Per-IP/per-account limits bound one sender; this bounds the
# total, because every notification is a mail the operator pays for out of the
# SMTP quota that verification and password-reset mail also use. Past the
# ceiling a submission is still stored and returned, only the notification is
# suppressed.
FEEDBACK_NOTIFY_LIMIT="60"
# Auth mail (verification + password reset) allowed per hour, globally, across
# all addresses and every source. Same reasoning as the ceiling above: the
# per-IP and per-account limits on those routes bound one sender against one
# mailbox and say nothing about the total, while the SMTP quota is shared with
# receipts, refunds and notifications. Past the ceiling the send is skipped —
# and the token rotation with it, so a link already sitting in an inbox keeps
# working — and the skip is logged once per window. 300/hour is far above any
# real signup flow.
AUTH_MAIL_HOURLY_LIMIT="300"

# Deadline for ONE outbound provider/LLM call, body read included. Each call
# site has its own default (15s router, 30s assistant/moderation, 300s image
# models); only raise this if a provider legitimately needs longer.
# OUTBOUND_TIMEOUT_MS=""

# Image providers — optional: fall back to ~/.cc-proxy/config.json when unset
# Availability probed 2026-08-22: modelverse (gpt-image-2) and ark
# (seedream/seedance) OK; aliyun wan2.7-* models return 403 "API-Key
# restrictions" — wan models are disabled in lib/model-registry.ts until the
# DashScope key's model restrictions are lifted. Nothing reads ALIYUN_API_KEY
# while those models are off: the prompt assistant resolves the DeepSeek pair
# below (the GLM path was removed 2026-09-19).
MODELVERSE_IMAGE_API_KEY=""
ARK_IMAGE_API_KEY=""
# Same credential as ALIYUN_API_KEY: getAliyunKey() takes either name. Both
# production anchors forward the ALIYUN_ spelling (and now this one too), so
# either works in a container — but they are alternatives, not a pair.
ALIYUN_API_KEY=""
DASHSCOPE_API_KEY=""

# DeepSeek prompt assistant (optional: fall back to cc-proxy gateway "deepseek" / "modelverse").
# The key and the endpoint are resolved as ONE pair (lib/keys.ts): setting only
# one leaves the pair ignored — the assistant then answers with its offline
# expander and smart routing with its static default, and the app says so once at
# boot. For the vendor API set DEEPSEEK_BASE_URL="https://api.deepseek.com"; for
# a relay set its own base URL, never the key alone.
# NOTE for containers: docker-compose*.yml forward both (the anchors used to name
# only the key, so the documented single-key setup was silently half-set).
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL=""

# Smart routing and the prompt assistant both resolve the DeepSeek pair above —
# there is no separate "smart routing model" credential. These two names appeared
# here and nowhere else in the repo: setting them changed nothing.

# Payment provider: "mock" (default) | "stripe" | "paddle"
# ("alipay" / "wechat" require a CN business entity — not implemented yet)
PAYMENT_PROVIDER="mock"

# Stripe Checkout (test mode works without a business entity)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYMENT_SUCCESS_URL=""
PAYMENT_CANCEL_URL=""

# Paddle Billing (Merchant of Record; sandbox works without a business entity)
PADDLE_API_KEY=""
PADDLE_ENVIRONMENT="sandbox" # sandbox | production
PADDLE_WEBHOOK_SECRET=""

# Storage: local | s3 (MinIO/R2/S3). "local" is what a HOST-RUN dev server wants
# (`npm run dev` / `npx next start` — the app and the files share a filesystem).
# In a container it is a trap, so docker-compose.yml PINS this to s3 and ignores
# this line: there "local" resolves to /app/data/files inside each container's own
# writable layer, nothing is mounted for it, and the worker's writes are invisible
# to the web container's reads (every delivered image 404s, `compose down` deletes
# them) while /api/health still reports storage "up". The production composes pin
# s3 as well.
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="data/files"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
# The endpoint is PRESIGNED and handed to clients (the public API's image URLs)
# and to the external moderation detector, so it must be reachable from outside
# the deployment — a compose-internal name like http://storage:9000 produces URLs
# that resolve nowhere for anyone else. Which deployment reads what:
#   docker-compose.yml          pinned to http://storage:9000 and NOT overridable:
#                               there the variable is both the S3 client's endpoint
#                               and the presigned host, and the app runs inside the
#                               compose network, so an .env value meant for a
#                               host-run app (http://localhost:9000) resolves to
#                               the container itself
#   docker-compose.prod.yml     required; set the public endpoint
#   docker-compose.single.yml   defaults to http://storage:9000; override it with
#                               the MinIO reverse-proxy domain in production
# /api/files does not consume this value at all — it streams the object through
# the app. Only /api/v1/images/generations/[id] hands out a presigned URL.
# Dev compose defaults are "pixelduo"/"pixelduo-secret" — change these in any
# non-local environment.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# Rate limiting: unset = in-memory (single instance); set = global Redis-backed
REDIS_URL="redis://localhost:6379"
# Edge middleware coarse limits (per instance per minute). For a signed-in
# request the bucket is the account + session cookie; /api/auth/* is ALWAYS
# charged to the source address as well, so a re-minted cookie cannot refresh
# the brake in front of password verification (pass 32)
MIDDLEWARE_AUTH_LIMIT="40"
MIDDLEWARE_API_LIMIT="300"
# Registrations per IP per hour (tests/CI raise this)
REGISTER_RATE_LIMIT="10"
# OAuth callback cap (per IP per minute): the sign-up path is the expensive one
# (a provider round trip plus a DB write), so it has its own budget.
OAUTH_CALLBACK_RATE_LIMIT=""

# Timezone defining the daily check-in "day" (IANA name). Default Asia/Shanghai
# so the day rolls over at local midnight for CN users; set UTC for other markets.
CHECKIN_TIMEZONE="Asia/Shanghai"

# Object backup (self-hosted MinIO/S3): mirrors user images daily to
# ./backups/objects (keep N snapshots) and optionally off-site to a second bucket.
# Managed object stores should enable versioning + cross-region replication instead.
#
# BACKUP_KEEP is the DB-dump retention (the `backup` service, default 14);
# BACKUP_KEEP_OBJECTS is the object-snapshot retention (default 7). Both used to
# be hardcoded literals in the compose files while this file documented a knob
# that could not reach them — so an operator who lowered it kept whatever the
# file happened to say and the disk filled anyway.
BACKUP_KEEP="14"
BACKUP_KEEP_OBJECTS="7"
# The uid:gid the `backup` / `backup-objects` services run as, so the snapshots
# land in ./backups owned by the host operator instead of root:root 0600 (which
# made the documented `pg_restore` / offsite-copy steps fail with "Permission
# denied"). Defaults to 1000:1000; set them to `id -u`/`id -g` of the account
# that owns this clone.
BACKUP_UID="1000"
BACKUP_GID="1000"
BACKUP_TARGET_ENDPOINT=""
BACKUP_TARGET_ACCESS_KEY_ID=""
BACKUP_TARGET_SECRET_ACCESS_KEY=""
BACKUP_TARGET_BUCKET=""

# Monitoring (optional; no-op when unset)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
# Tags server/edge/worker events with the build they came from. It does NOT
# reach the browser bundle: only NEXT_PUBLIC_* names are inlined into the client
# (see instrumentation-client.ts), so the client-side release stays undefined —
# wiring it would need a NEXT_PUBLIC_SENTRY_RELEASE build arg, deliberately
# declined in pass 25.
SENTRY_RELEASE=""
# The browser bundle's DSN. It is compiled INTO the client bundle, so it is a
# BUILD-time value: changing it needs a rebuild, and in a container it must be
# passed as a build arg (the compose files name it under build.args). Setting
# this without SENTRY_DSN leaves server-side reporting off.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"
# NOT consumed by the image build, on purpose — leave it unset unless you are
# building outside Docker with both this and SENTRY_DSN in the environment.
# It used to be a Docker build ARG, which is not a secret channel: the value is
# recorded in the image history (`docker history --no-trunc`) and inside every
# `docker save` / registry tarball, and it bought nothing, because the Sentry
# wrapper is gated on SENTRY_DSN (next.config.mjs) and no compose build sets it.
# So containerised builds produce no source maps and Sentry stacks stay
# minified; wiring the upload means a BuildKit secret mount, see the Dockerfile.
SENTRY_AUTH_TOKEN=""

# Post-generation image moderation via vision model (strictly SFW product).
# Any non-empty value except 0 requests an audit (so `true`/`yes` cannot
# silently mean "off"); 0 or unset means no audit. Requested-but-impossible is
# fail-closed: the worker REFUSES TO START when no vision config resolves, and
# a configured-but-failing detector fails the job (refunded, object deleted).
# Videos are NOT audited — there is no video detector to call.
IMAGE_MODERATION="1"
VISION_MODERATION_MODEL="gpt-5.6-luna"
# Required in production when IMAGE_MODERATION is on — otherwise the worker
# exits at boot rather than delivering unaudited images. Set BOTH or NEITHER:
# the pair is atomic, and setting only one counts as "no vision config" (half
# of an env pair is never completed from another source, which would send one
# gateway's credential to a different host). The in-image fallback is the local
# ~/.cc-proxy/config.json, which does not exist in containers.
#
# It must be a PUBLIC http(s) host (the same rule IMAGE_NSFW_ENDPOINT has): the
# request carries this key and the image under audit, so it goes through the
# SSRF-guarded, DNS-pinned client. A private/loopback gateway therefore cannot be
# reached — the audit reports itself unavailable and the job fails closed
# (refunded) rather than being delivered unaudited. Expose it publicly, or run
# with IMAGE_MODERATION=0.
VISION_MODERATION_BASE_URL=""
VISION_MODERATION_API_KEY=""

# OAuth providers (optional — uncomment and set to enable social login)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Custom watermark text (default: "PixelDuo · AI 生成")
WATERMARK_TEXT=""

# External NSFW detection endpoint (optional; takes precedence over the vision
# path when set). The worker POSTs {"url": "<presigned object URL>"} and the
# endpoint must answer {"flagged": <boolean>} — any other 2xx body counts as
# "could not audit" (fail-closed), so a score-shaped or error reply cannot pass
# an image through. The endpoint must be able to FETCH the object store: with
# STORAGE_DRIVER=local the object is only reachable at /api/files and the
# external path refuses to claim it audited anything.
IMAGE_NSFW_ENDPOINT=""

# Dev: where to write emails to disk when SMTP_URL is unset
MAIL_DEV_DIR=""

# CI / testing only — never enable in production
# 1 = all image/video generation returns mock data instantly (no provider calls)
MOCK_IMAGE_PROVIDER=""
# 1 = allow PAYMENT_PROVIDER=mock even on a production build (CI only)
PAYMENT_ALLOW_MOCK=""

# Sentry traces sample rate (0.0–1.0; unset = no performance tracing)
SENTRY_TRACES_SAMPLE_RATE=""
