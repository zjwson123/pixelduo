# Database (Postgres — docker-compose provides local instance)
# POSTGRES_USER/PASSWORD/DB are used by docker-compose to create the DB and
# build DATABASE_URL. Change them from the defaults for any shared environment.
POSTGRES_USER=pixelduo
POSTGRES_PASSWORD=pixelduo
POSTGRES_DB=pixelduo
DATABASE_URL="postgresql://pixelduo:pixelduo@localhost:5432/pixelduo"
TEST_DATABASE_URL="postgresql://pixelduo:pixelduo@localhost:5432/pixelduo_test"

# Auth
# Must be >= 32 random characters: it signs every session JWT, so a guessable
# value is a full authentication bypass. Generate with `openssl rand -base64 32`.
# A production boot refuses placeholder/too-short values (instrumentation.ts).
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
# Per-IP rate limits read the LAST X-Forwarded-For entry (the one the edge
# proxy appends; Caddy's reverse_proxy always sets it). Only set this to 1 if
# your ingress sets X-Real-IP and does NOT set X-Forwarded-For — otherwise the
# client could choose its own bucket and defeat every per-IP limit.
TRUST_X_REAL_IP="0"

# Email (verification / password reset). Unset = dev mode logs the email link
# to the server console. Production: set SMTP_URL (SES/SendGrid/Resend SMTP) —
# production refuses to start without it, because the log-only mailer would
# write live password-reset links into the container log. MAIL_DEV_MODE=1 is
# the explicit opt-in for that behaviour.
SMTP_URL=""
EMAIL_FROM="PixelDuo <no-reply@pixelduo.ai>"
# Where user feedback (POST /api/feedback) is delivered. MUST be set in
# production: the fallback in lib/mail.ts is a personal mailbox, and a
# production runtime refuses to send feedback mail at all while FEEDBACK_TO is
# empty (the message is still stored and shown in the admin console). Reply-To
# is the reporter, so replying in your mail client answers them. Compose only
# forwards the variables its x-appenv anchor names, so this has to be listed
# there too — see docker-compose.yml.
FEEDBACK_TO=""
# 1 = auto-verify emails on register (tests/CI only; do not enable in prod)
EMAIL_VERIFY_AUTO="0"
# Opt in to the log-only mailer in production (see SMTP_URL above).
MAIL_DEV_MODE="0"

# Optional second notification channel, for hosts where SMTP is not an option
# (no provider account, no verified sending domain): a Feishu/WeCom/DingTalk
# group bot. The URL is a bearer secret — never commit it, and note the
# pre-flight scripts print it masked for that reason. Verify with
# `npx tsx scripts/verify-webhook.ts` (add --print to see the JSON only).
FEEDBACK_WEBHOOK_URL=""
FEEDBACK_WEBHOOK_KIND="feishu"   # feishu | wecom | dingtalk | raw
# Outbound feedback notifications (mail + webhook) allowed per hour, across all
# source addresses. Per-IP/per-account limits bound one sender; this bounds the
# total, because every notification is a mail the operator pays for out of the
# SMTP quota that verification and password-reset mail also use. Past the
# ceiling a submission is still stored and returned, only the notification is
# suppressed.
FEEDBACK_NOTIFY_LIMIT="60"

# Deadline for ONE outbound provider/LLM call, body read included. Each call
# site has its own default (15s router, 30s assistant/moderation, 300s image
# models); only raise this if a provider legitimately needs longer.
# OUTBOUND_TIMEOUT_MS=""

# Image providers — optional: fall back to ~/.cc-proxy/config.json when unset
# Availability probed 2026-08-22: modelverse (gpt-image-2) and ark
# (seedream/seedance) OK; aliyun wan2.7-* models return 403 "API-Key
# restrictions" — wan models are disabled in lib/model-registry.ts until the
# DashScope key's model restrictions are lifted. ALIYUN_API_KEY is still used
# by the GLM prompt assistant.
MODELVERSE_IMAGE_API_KEY=""
ARK_IMAGE_API_KEY=""
ALIYUN_API_KEY=""
DASHSCOPE_API_KEY=""

# DeepSeek prompt assistant (optional: fall back to cc-proxy gateway "deepseek" / "modelverse")
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL=""

# Smart routing model (defaults to deepseek-v4-flash via cc-proxy)
SMART_ROUTING_API_KEY=""
SMART_ROUTING_BASE_URL=""

# Payment provider: "mock" (default) | "stripe" | "paddle"
# ("alipay" / "wechat" require a CN business entity — not implemented yet)
PAYMENT_PROVIDER="mock"

# Stripe Checkout (test mode works without a business entity)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYMENT_SUCCESS_URL=""
PAYMENT_CANCEL_URL=""

# Paddle Billing (Merchant of Record; sandbox works without a business entity)
PADDLE_API_KEY=""
PADDLE_ENVIRONMENT="sandbox" # sandbox | production
PADDLE_WEBHOOK_SECRET=""

# Storage: local (default) | s3 (MinIO/R2/S3)
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="data/files"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
# Dev compose defaults are "pixelduo"/"pixelduo-secret" — change these in any
# non-local environment.
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# Rate limiting: unset = in-memory (single instance); set = global Redis-backed
REDIS_URL="redis://localhost:6379"
# Edge middleware coarse limits (per instance per IP per minute)
MIDDLEWARE_AUTH_LIMIT="40"
MIDDLEWARE_API_LIMIT="300"
# Registrations per IP per hour (tests/CI raise this)
REGISTER_RATE_LIMIT="10"

# Timezone defining the daily check-in "day" (IANA name). Default Asia/Shanghai
# so the day rolls over at local midnight for CN users; set UTC for other markets.
CHECKIN_TIMEZONE="Asia/Shanghai"

# Object backup (self-hosted MinIO/S3): mirrors user images daily to
# ./backups/objects (keep N snapshots) and optionally off-site to a second bucket.
# Managed object stores should enable versioning + cross-region replication instead.
BACKUP_KEEP="7"
BACKUP_TARGET_ENDPOINT=""
BACKUP_TARGET_ACCESS_KEY_ID=""
BACKUP_TARGET_SECRET_ACCESS_KEY=""
BACKUP_TARGET_BUCKET=""

# Monitoring (optional; no-op when unset)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="production"
SENTRY_RELEASE=""
NEXT_PUBLIC_SENTRY_DSN=""

# Post-generation image moderation via vision model (strictly SFW product).
# Any non-empty value except 0 requests an audit (so `true`/`yes` cannot
# silently mean "off"); 0 or unset means no audit. Requested-but-impossible is
# fail-closed: the worker REFUSES TO START when no vision config resolves, and
# a configured-but-failing detector fails the job (refunded, object deleted).
# Videos are NOT audited — there is no video detector to call.
IMAGE_MODERATION="1"
VISION_MODERATION_MODEL="gpt-5.6-luna"
# Required in production when IMAGE_MODERATION is on — otherwise the worker
# exits at boot rather than delivering unaudited images. Set BOTH or NEITHER:
# the pair is atomic, and setting only one counts as "no vision config" (half
# of an env pair is never completed from another source, which would send one
# gateway's credential to a different host). The in-image fallback is the local
# ~/.cc-proxy/config.json, which does not exist in containers.
VISION_MODERATION_BASE_URL=""
VISION_MODERATION_API_KEY=""

# OAuth providers (optional — uncomment and set to enable social login)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""

# Custom watermark text (default: "PixelDuo · AI 生成")
WATERMARK_TEXT=""

# External NSFW detection endpoint (optional; takes precedence over the vision
# path when set). The worker POSTs {"url": "<presigned object URL>"} and the
# endpoint must answer {"flagged": <boolean>} — any other 2xx body counts as
# "could not audit" (fail-closed), so a score-shaped or error reply cannot pass
# an image through. The endpoint must be able to FETCH the object store: with
# STORAGE_DRIVER=local the object is only reachable at /api/files and the
# external path refuses to claim it audited anything.
IMAGE_NSFW_ENDPOINT=""

# Dev: where to write emails to disk when SMTP_URL is unset
MAIL_DEV_DIR=""

# CI / testing only — never enable in production
# 1 = all image/video generation returns mock data instantly (no provider calls)
MOCK_IMAGE_PROVIDER=""
# 1 = allow PAYMENT_PROVIDER=mock even on a production build (CI only)
PAYMENT_ALLOW_MOCK=""

# Sentry traces sample rate (0.0–1.0; unset = no performance tracing)
SENTRY_TRACES_SAMPLE_RATE=""
