generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  role          String   @default("user") // user | admin
  credits       Int      @default(0)
  plan          String   @default("free") // free | starter | pro | studio
  planRenewsAt  DateTime?
  emailVerified DateTime?
  sessionVersion Int     @default(0) // bumped on password reset / revoke-all
  totpSecret        String? // enabled TOTP secret (base32)
  totpPendingSecret String? // secret awaiting confirmation during setup
  totpEnabled       Boolean  @default(false)
  createdAt     DateTime @default(now())

  ledgers  LedgerEntry[]
  jobs     Job[]
  images   Image[]
  orders   Order[]
  checkins Checkin[]
  grants   CreditGrant[]
  tokens   VerificationToken[]
  feedback Feedback[]
}

// Single-use 2FA recovery codes (SHA-256 hashes only).
model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Public API access keys (SHA-256 hash only; raw key shown once at creation).
model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  prefix     String
  // The account's sessionVersion when this key was minted. A key is a
  // credential of the session that created it (same rule the JWT follows), so
  // authenticateApiKey refuses a key whose stamped version no longer matches
  // the account's. The explicit revokes on reset/revoke-sessions/2FA stay (they
  // are what the console shows the user), but they are a read-then-write and
  // this is the atomic half: without it, a mint already inside its locked
  // transaction could COMMIT after the revocation's `updateMany … revokedAt:
  // null` had run, leaving a permanent pd_live_ key the reset was supposed to
  // kill. The version bump travels with the same transaction, so ordering can
  // no longer matter.
  sessionVersion Int    @default(0)
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Single-use email verification / password-reset tokens. Only the SHA-256
// hash is stored; raw tokens travel in the email link.
model VerificationToken {
  id         String    @id @default(cuid())
  email      String
  userId     String?
  purpose    String // verify-email | reset-password
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, purpose, createdAt])
  @@index([userId])
}

// Deduplicates credit-expiry reminder emails (one per grant per bucket).
model CreditReminder {
  id         String   @id @default(cuid())
  grantId    String
  userId     String
  daysBefore Int // 7 | 3 | 1
  sentAt     DateTime @default(now())

  @@unique([grantId, daysBefore])
  @@index([userId])
}

// Double-entry ledger: balance is derived from the latest balanceAfter per user.
model LedgerEntry {
  id           String   @id @default(cuid())
  userId       String
  type         String // SIGNUP_BONUS | CHECKIN | PURCHASE | SUBSCRIPTION | PRE_AUTH | SETTLE | REFUND | EXPIRE | ADMIN
  creditsDelta Int
  balanceAfter Int
  refType      String? // job | order | none
  refId        String?
  note         String?
  // Who caused this row, when that is not the row's user (an operator's
  // clawback). Null for every user-initiated movement. It exists
  // because the clawback needs BOTH attributions at once (pass 36): the row's
  // refType/refId must name the ORDER the taken credits came from, so
  // cycleUsageTx's revoked scan can tell a clawed-back plan quota from a
  // clawed-back credit pack, while the operator who took them is a separate
  // fact the ledger is the only record of. Before this column one of the two
  // had to be dropped.
  actorId      String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  // cycleUsageTx resolves a plan cycle's spend with
  // `userId = ? AND refId IN (…) AND type IN (…)` (lib/ledger.ts) — once per
  // chunk of job ids, inside the payment webhook's interactive transaction.
  // Without this index each chunk is a scan of the account's LIFETIME ledger
  // (the (userId, createdAt) index cannot serve a refId predicate), so the
  // cost is cycle-jobs × lifetime-rows: measured 6.3s at 33k cycle jobs and
  // 10.1s at 100k against a 5s Prisma transaction timeout, i.e. the same
  // "paid renewal 500s and the retry stream re-runs it" outcome pass 18 fixed
  // the bind-variable ceiling for.
  @@index([userId, refId])
}

// Credit grants with expiry (commercial policy):
// - PURCHASE (credit packs): 12 months validity
// - SUBSCRIPTION (monthly quota): valid until planRenewsAt (cycle end)
// - ROLLOVER (30% carryover): valid only until the following cycle end
// - SIGNUP_BONUS / CHECKIN (free credits): never expire, consumed first
// User.credits must equal SUM(remaining) at all times.
model CreditGrant {
  id        String    @id @default(cuid())
  userId    String
  source    String // SIGNUP_BONUS | CHECKIN | PURCHASE | SUBSCRIPTION | ROLLOVER | ADMIN | REFUND
  amount    Int // original grant
  remaining Int
  expiresAt DateTime?
  refType   String? // order | none (source of the grant for audit/revocation)
  refId     String? // order.id when created from a paid order
  // The order whose CYCLE this grant belongs to, when that is not the order it
  // was measured from. A ROLLOVER is stamped with the previous cycle's order in
  // refId (refunding that cycle must take the carryover back), but it is spent
  // inside the NEW cycle — so refunding the renewal that minted it must also
  // reach it. One refId cannot name both orders; this column names the second.
  // REFUND replacements inherit it from the grant they replace.
  cycleOrderId String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([refId])
  @@index([cycleOrderId])
}

model Job {
  id             String    @id @default(cuid())
  userId         String
  status         String    @default("queued") // queued | running | polling | done | failed
  model          String // gpt | seedream | both | wan-image | wan-image-pro | seedance | wan-t2v | wan-i2v
  mediaType      String    @default("image") // image | video
  quality        String    @default("medium")
  count          Int       @default(1)
  prompt         String
  costCredits    Int
  images         String // JSON array of image/video urls (local paths)
  error          String?
  worker         String?
  attempts       Int      @default(0)
  maxAttempts    Int      @default(3)
  nextAttemptAt  DateTime?
  heartbeatAt    DateTime?
  consumption    Json? // [{grantId, amount}] consumed by the PRE_AUTH, for exact refunds
  idempotencyKey String?   @unique
  // Video async task tracking
  providerTaskId String? // external task id from Ark/DashScope
  taskCreatedAt  DateTime? // when the upstream task was created — the clock the 30-min cap runs on
  durationSec    Int? // video duration (for video jobs)
  refImageKey    String? // reference image storage key (for image editing / image-to-video)
  sourceVideoKey String? // extend input: storage key of the original video being continued
  extendOfJobId  String? // provenance: the finished video job this one extends
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([mediaType, status, createdAt])
}

model Image {
  id        String   @id @default(cuid())
  userId    String
  jobId     String?
  url       String
  model     String // gpt | seedream
  quality   String
  prompt    String
  credits   Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // /api/files resolves a user-owned asset by (userId, url) — one lookup per
  // asset a gallery page renders (~60 per page). With only (userId, createdAt)
  // indexed, the url predicate was a filter over every row the user owns; this
  // is the same lookup Template solves with its @@index([img]).
  @@index([userId, createdAt])
  @@index([userId, url])
}

model Template {
  id        String   @id
  cat       String
  title     String
  prompt    String
  model     String   // gpt | seedream (heuristic for imported cases)
  quality   String
  credits   Int
  img       String
  sourceUrl String?  // attribution link for community-sourced cases
  tags      Json?     // { styles: [...], scenes: [...] } from upstream tags
  featured  Boolean  @default(false)

  // /api/files resolves a thumbnail by img, one lookup per Explore render.
  @@index([img])
}

model Order {
  id               String    @id @default(cuid())
  userId           String
  kind             String // pack | plan
  provider         String // mock | paddle | alipay | wechat
  providerOrderId  String?
  amountUsd        Float
  credits          Int
  planId           String?
  status           String    @default("pending") // pending | paid | refunded
  idempotencyKey   String    @unique
  createdAt        DateTime  @default(now())
  paidAt           DateTime?
  // Money the provider has given back against this order, accumulated across
  // refund webhooks (pass 32). Stripe reports a refund cumulatively and needs
  // no state, but Paddle labels every adjustment by its OWN scope: two $25
  // partials against a $49.99 pack are both `partial`, so "the flag says
  // partial" stayed true while the customer got everything back — the order
  // stayed paid and the credits stayed granted. The route sums each delivery's
  // own amount here and promotes to a full revoke once the total reaches
  // amountUsd. Existing rows read 0, the correct starting value.
  refundedAmountUsd Float    @default(0)
  // Money returned by a chargeback/dispute, cumulative per payment (pass 41).
  // Stripe reports refunds and disputes independently — charge.refunded carries
  // `amount_refunded` only, charge.dispute.created carries only the disputed
  // amount — so keeping just one number let a partial refund plus a partial
  // dispute of the remainder return the full price without either figure
  // reaching it. The webhook sums this with refundedAmountUsd when deciding
  // whether the order was returned in full. Paddle's adjustments (including
  // chargebacks) stay in refundedAmountUsd, so this column is 0 for them.
  disputedAmountUsd Float    @default(0)
  // Which dispute reinstatements have already been subtracted, as
  // `reinstated:<disputeId>` markers (pass 43). Stripe reports a won dispute
  // twice — `charge.dispute.funds_reinstated` and `charge.dispute.closed` with
  // status `won` — and subtracting the amount on both deliveries would drive
  // the accumulated disputed total too low, hiding a genuine partial refund
  // that should have promoted to a full revoke.
  disputeReinstatements String[] @default([])
  // Which provider adjustments have already been counted, as
  // `<adjustmentId>:approved` / `<adjustmentId>:reversed` markers (pass 36).
  // The accumulation above is per DELIVERY, and the only dedupe was
  // PaymentEvent.eventId — which a provider can change while re-sending the
  // same adjustment (at-least-once delivery, a payout update re-emitting an
  // approved adjustment): two signed deliveries of ONE $25 partial then summed
  // to $50 against a $49.99 order and promoted a partial refund to a full
  // revoke (probed end to end through the route). Markers are kind-suffixed
  // because Paddle delivers the reversal of an adjustment as a SECOND
  // delivery for the same adjustment id (status `reversed`, a negative delta —
  // pass 33), which must still apply exactly once. Stripe needs none of this:
  // it reports `amount_refunded` cumulatively, and the route writes it to
  // refundedAmountUsd as an absolute maximum instead of a delta.
  refundedAdjustments String[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Every order listing (user history, admin table, account export) filters by
  // userId and had no index on it at all, so an account hoarding junk pending
  // orders degraded those reads for every user into sequential scans.
  @@index([userId, createdAt])
  // Refund/dispute webhooks resolve an order by the provider's payment id
  // inside the webhook transaction (pass 41) — a sequential scan of a table that
  // grows with every checkout, on the one path a provider retries for days.
  @@index([providerOrderId])
}

// Idempotent payment webhook events
model PaymentEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String   @unique
  orderId     String?
  rawJson     String
  processedAt DateTime @default(now())
}

model Checkin {
  id        String   @id @default(cuid())
  userId    String
  date      String // YYYY-MM-DD
  credits   Int      @default(2)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// User feedback / messages (bug reports, feature ideas, billing questions).
// Written by POST /api/feedback (also reachable signed-out, so a user who
// cannot log in can still reach us), read in the admin console's feedback tab.
// `userId` is nullable because anonymous reports are allowed; `email` is the
// reply-to address (the account's when signed in, the form's when not) and is
// what an operator answers, so it is kept even if the account is later deleted
// by hand — the Cascade below is the erasure path, and it removes the whole row.
model Feedback {
  id         String    @id @default(cuid())
  userId     String?
  email      String
  category   String // idea | bug | billing | other
  message    String
  status     String    @default("new") // new | done
  // Context the reporter does not have to type: the page they were on, the UI
  // language, their plan, the build. A bug report without these is usually
  // unactionable ("the button did not work").
  page       String?
  locale     String?
  plan       String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  handledAt  DateTime?
  handledBy  String? // admin user id

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId])
}
