{
  "name": "pixelduo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prune-standalone.mjs",
    "start": "next start",
    "db:migrate": "RUST_LOG=debug npx prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "expire": "tsx scripts/expire.ts",
    "test": "npm run test:prep && vitest run",
    "test:prep": "RUST_LOG=debug DATABASE_URL=\"postgresql://pixelduo:pixelduo@localhost:5432/pixelduo_test\" npx prisma migrate deploy",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@paddle/paddle-node-sdk": "^3.10.0",
    "@sentry/nextjs": "^10.74.0",
    "@sentry/node": "^10.74.0",
    "bcryptjs": "^2.4.3",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "next": "^16.3.8",
    "next-auth": "^4.24.15",
    "nodemailer": "^10.0.12",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "stripe": "^17.7.0",
    "undici": "^8.10.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@prisma/client": "^6.16.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "prisma": "^6.16.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "@prisma/client@6.16.2": true,
    "@prisma/engines@6.19.3": true,
    "@sentry/cli@2.58.6": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "prisma@6.19.3": true,
    "sharp@0.35.5": true
  }
}
